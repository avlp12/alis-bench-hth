# ============================================================================
#  Head-to-head benchmark config  —  Motif-3-Beta  vs  Solar Open 2 (MLX)
#  Source this before any script:  `source config.env`
#  GOLDEN RULE: everything that is not the model-under-test must be IDENTICAL.
# ============================================================================

# --- MLX build dirs: each model's OWN best runnable build (edit these) ------
#     best-vs-best: NOT a matched tier — each model's peak build on the box.
# Tier ladders (each side quantized by its own team, matched only by ROLE):
#   floor      Motif 2.3bpw (85GB)   <->  Solar F-v2 (68GB)
#   mid        Motif 4.5bpw (167GB)  <->  Solar Q-v3 (146GB)
#   reference  Motif 8bit  (334GB)   <->  Solar T    (266GB)     <- KL anchors
# NOTE 2026-07-26: the Motif 8bit reference is KNOWN BROKEN (mx.split >2^31
# corruption, pre-workaround build) and is being rebuilt — until then Motif has
# no KL anchor and that cell must be reported as MISSING, not silently skipped.
export MOTIF_MODEL="${MOTIF_MODEL:-/Users/m3ms/motif3/models/Motif-3-2.3bpw}"
export SOLAR_MODEL="${SOLAR_MODEL:-/Users/m3ms/solar/models/Solar-Open2-F-v2}"

# --- Per-model 8-bit references (for KL / quant-damage isolation) -----------
export MOTIF_REF="${MOTIF_REF:-}"   # 8bit reference BROKEN -> unset until rebuilt
export SOLAR_REF="${SOLAR_REF:-/Users/m3ms/solar/models/Solar-Open2-T}"

# --- Serving endpoints (each model on its own box: Gesicht / Epsilon) -------
#     Quality evals are deterministic -> two boxes in parallel is fine.
#     EFFICIENCY numbers must be taken on ONE box (see throughput_probe.py).
export MOTIF_URL="${MOTIF_URL:-http://gesicht.local:8081}"
export SOLAR_URL="${SOLAR_URL:-http://epsilon.local:8082}"

# --- best-vs-best generation policy ----------------------------------------
# Each model runs at ITS OWN PEAK; we DISCLOSE the settings, we do not clamp them.
export BPW_TIER="${BPW_TIER:-best}"        # label only; each model at its own best build
export SEED="${SEED:-1234}"
# THINKING is a DISCLOSURE label recorded in the manifest — enabling a model's
# thinking mode itself is done via its own chat template / system prompt, so set
# this to what you actually configured on the server (it is reported, not enforced).
export THINKING="${THINKING:-on}"
export MAX_TOKENS="${MAX_TOKENS:-8192}"    # reasoning budget; judge/throughput record tokens ACTUALLY spent
# NOTE: k-sample self-consistency / best-of-k is NOT implemented (single sample per
# item). Do not add a GEN_SAMPLES knob that silently does nothing — implement it first.
# HRET KO language penalty: off (raw correctness primary) | on | both
export HRET_PENALIZE="${HRET_PENALIZE:-off}"
# Per-model recommended sampling — each model's OWN best (fill from each model card):
export MOTIF_TEMP="${MOTIF_TEMP:-1.0}"; export MOTIF_TOP_P="${MOTIF_TOP_P:-0.95}"
export SOLAR_TEMP="${SOLAR_TEMP:-0.7}"; export SOLAR_TOP_P="${SOLAR_TOP_P:-0.95}"

# --- Neutral judge (MUST NOT be either contender) --------------------------
export JUDGE_BASE_URL="${JUDGE_BASE_URL:-https://api.openai.com/v1}"
export JUDGE_MODEL="${JUDGE_MODEL:-gpt-5.1}"
export JUDGE_API_KEY="${JUDGE_API_KEY:-}"  # export your key before running judge_pairwise.py

# --- Paths -----------------------------------------------------------------
export RESULTS_DIR="${RESULTS_DIR:-/Users/gesicht/motif3/h2h/results/${BPW_TIER}}"
export MLXLM_FORK="${MLXLM_FORK:-/Users/gesicht/glm5.2/mlx-lm}"   # Motif model class lives here (@motif)
export ALISDWQ_DIR="${ALISDWQ_DIR:-/Users/gesicht/alis-dwq}"

# --- publication-grade knobs (adversarial-review hardening) ----------------
export SUITE_MODE="${SUITE_MODE:-full}"         # full = decontaminated + fail-closed | smoke = non-publishable
export EQUIV_MARGIN="${EQUIV_MARGIN:-0.0}"      # practical-effect threshold for a per-task verdict (fraction)
export JUDGE_MARGIN="${JUDGE_MARGIN:-0.0}"      # same for the pairwise sign-test
export BOOTSTRAP_N="${BOOTSTRAP_N:-2000}"
export ALLOW_PARTIAL="${ALLOW_PARTIAL:-}"       # set 1 to force a clearly-marked PARTIAL report past the gate
# >=2 NEUTRAL judges (neither contender), each an OpenAI-compatible /chat/completions endpoint:
export JUDGE_ENDPOINTS="${JUDGE_ENDPOINTS:-}"   # '[{"name":"gpt","model":"gpt-5.1","base_url":"https://api.openai.com/v1","key_env":"OPENAI_API_KEY"},{"name":"ko","model":"...","base_url":"https://.../v1","key_env":"KO_JUDGE_KEY"}]'

echo "[config] tier=$BPW_TIER suite=$SUITE_MODE thinking=$THINKING seed=$SEED  motif=$MOTIF_URL solar=$SOLAR_URL  -> $RESULTS_DIR" >&2

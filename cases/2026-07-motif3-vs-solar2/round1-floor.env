# R1 — floor round:  Motif 2.3bpw  ↔  Solar F-v2 (+DWQ LoRA)
# Both served on GESICHT so the efficiency numbers are same-box valid.
# Epsilon is busy rebuilding the Motif 8-bit reference; do not run models there.
#   source round1-floor.env && ../../harness/preflight.sh

# --- contenders (each at its own team's optimum for this tier) --------------
export MOTIF_MODEL="/Users/gesicht/motif3/models/Motif-3-2.3bpw"
export SOLAR_MODEL="/Users/gesicht/Documents/kimi/workspace/builds/F-v2-dwq-t"
# Solar's rank-8 LoRA carries its DWQ correction — best-vs-best serves WITH it
export SOLAR_ADAPTER="/Users/gesicht/Documents/kimi/workspace/alis_adapters"
export MOTIF_ADAPTER=""

# --- KL anchors -------------------------------------------------------------
# Motif has NO usable anchor: the 8-bit reference is defective and being rebuilt.
# Its KL cell must read MISSING (never zero, never compared to Solar's).
export MOTIF_REF=""
export SOLAR_REF=""          # set to the Solar T build once it is staged

# --- per-side runtimes (stock mlx-lm knows neither architecture) ------------
export MOTIF_PYTHON="python3"
export MLXLM_FORK="/Users/gesicht/glm5.2/mlx-lm"                       # @bench-runtime-2026-07-26
export SOLAR_PYTHON="/Users/gesicht/Documents/kimi/workspace/.venv-verify/bin/python"
export SOLAR_FORK="/Users/gesicht/Documents/kimi/workspace/mlx-lm"     # 9d67a0c

# --- endpoints (same box, two ports) ---------------------------------------
export MOTIF_URL="http://127.0.0.1:8081"
export SOLAR_URL="http://127.0.0.1:8082"

# --- round identity + policy ------------------------------------------------
export BPW_TIER="floor"
export RESULTS_DIR="/Users/gesicht/alis-bench-hth/cases/2026-07-motif3-vs-solar2/results/floor"
export SUITE_MODE="full"
export SEED=1234
export THINKING="on"
export MAX_TOKENS=32768
export MOTIF_TEMP=1.0; export MOTIF_TOP_P=0.95      # Motif card recommendation
export SOLAR_TEMP=1.0; export SOLAR_TOP_P=1.0       # Solar card (official)
export EQUIV_MARGIN=0.015
export BOOTSTRAP_N=2000
export HRET_PENALIZE="off"                          # raw correctness primary
export JUDGE_ENDPOINTS=""                           # no judge -> open-gen = NOT RUN (blind_pack.py later)

echo "[R1 floor] motif=$(basename $MOTIF_MODEL) vs solar=$(basename $SOLAR_MODEL)+LoRA -> $RESULTS_DIR" >&2

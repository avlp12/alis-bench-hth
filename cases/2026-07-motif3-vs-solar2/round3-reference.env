# R3 — reference round:  Motif Q8 (rebuilt) ↔ Solar T
# One model per box, each on its own local copy (no 560GB co-residency).
#   epsilon 10.0.0.2:8081  Motif Q8  312GB      gesicht 127.0.0.1:8082  Solar T 248GB
export MOTIF_MODEL="/Users/m3ms/motif3/models/Motif-3-Q8"
export SOLAR_MODEL="/Users/gesicht/Documents/kimi/workspace/builds/T-q8"
export MOTIF_ADAPTER=""; export SOLAR_ADAPTER=""      # T ships no adapter; F-v2's LoRA is not for this tier
export MOTIF_URL="http://10.0.0.2:8081"
export SOLAR_URL="http://127.0.0.1:8082"
# These builds ARE the 8-bit anchors, so KL-vs-own-reference is 0 by construction:
# leave unset so the cell reads MISSING rather than a meaningless zero.
export MOTIF_REF=""; export SOLAR_REF=""
export MOTIF_PYTHON="python3"; export MLXLM_FORK="/Users/gesicht/glm5.2/mlx-lm"
export SOLAR_PYTHON="/Users/gesicht/Documents/kimi/workspace/.venv-verify/bin/python"
export SOLAR_FORK="/Users/gesicht/Documents/kimi/workspace/mlx-lm"
export BPW_TIER="reference"
export RESULTS_DIR="/Users/gesicht/alis-bench-hth/cases/2026-07-motif3-vs-solar2/results/reference"
export SUITE_MODE="full"; export SEED=1234; export THINKING="on"; export MAX_TOKENS=32768
export MOTIF_TEMP=1.0; export MOTIF_TOP_P=0.95        # Motif card
export SOLAR_TEMP=1.0; export SOLAR_TOP_P=1.0         # Solar card (official)
export EQUIV_MARGIN=0.015; export BOOTSTRAP_N=2000; export HRET_PENALIZE="off"
export JUDGE_ENDPOINTS=""                              # no judge -> open-gen NOT RUN
echo "[R3 reference] Motif Q8 (epsilon) vs Solar T (gesicht) -> $RESULTS_DIR" >&2

# Preregistered sample: 150 items per task (2026-07-27). lm-eval --limit is
